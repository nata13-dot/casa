# Copia este archivo como .env (mismo directorio) y ajusta los valores.
# El .env NUNCA debe quedar dentro de public/.

APP_ENV=production
APP_TIMEZONE=America/Mexico_City

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=casa
DB_USER=casa_user
DB_PASS=cambia-esta-contrasena

# Código INICIAL que pide la app al registrarse (primer filtro; después un admin aprueba).
# En cuanto un admin lo cambie desde Ajustes › Administración, este valor deja de usarse
# (el nuevo se guarda en la BD como hash).
HOUSE_CODE=cambia-este-codigo-largo

# Orígenes permitidos para CORS, separados por coma.
# Capacitor en Android usa https://localhost; el servidor de desarrollo de Vite usa http://localhost:5173
CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost,http://localhost:5173

# URL pública con la que se construyen las rutas de las fotos (sin / final).
PUBLIC_URL=https://casa.tudominio.com

# Firebase Cloud Messaging (notificaciones push). Ver FIREBASE_NOTIFICACIONES.md.
# Opción A (recomendada): copia 3 valores del JSON de la cuenta de servicio.
#   FCM_PRIVATE_KEY va tal cual aparece en el JSON: una línea, con \n, entre comillas dobles.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Opción B: ruta ABSOLUTA al archivo JSON (se ignora si llenaste la opción A).
FCM_SERVICE_ACCOUNT=
# Vacío todo = sin notificaciones push (el resto de la app funciona igual).
