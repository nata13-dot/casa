# /etc/systemd/system/casa-recordatorios.timer
# Instalar una vez:
#   sudo cp /var/www/casa/api/deploy/casa-recordatorios.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now casa-recordatorios.timer
# Ver cuándo corre y qué envió:
#   systemctl list-timers casa-recordatorios.timer
#   journalctl -u casa-recordatorios -n 20
[Unit]
Description=Casa: recordatorios de los perritos cada 5 minutos

[Timer]
OnCalendar=*:0/5
AccuracySec=10s
Persistent=false

[Install]
WantedBy=timers.target
